{
    "name": "splicewire/laravel-beam-synthetic",
    "description": "Synthesize mode for Beam hosts: the neutral curve kernel, the blueprint and portfolio DTO family, the generic materializer and the financial-projection engine that let a host fill itself with synthetic tenants and project its own numbers forward. See AGENTS.md.",
    "keywords": [
        "laravel",
        "splicewire",
        "beam",
        "synthetic",
        "simulation",
        "projection"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-schema-convergence": "*",
        "rushing/php-popcorn": "dev-main",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/typescript-transformer": "^3.0",
        "splicewire/laravel-beam": "*",
        "splicewire/laravel-beam-commerce": "*",
        "splicewire/laravel-beam-tenancy": "*",
        "symfony/yaml": "^6.3|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Synthetic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Synthetic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Synthetic\\BeamSyntheticServiceProvider"
            ]
        },
        "package-topology": {
            "because": "beam-synthetic is the beam-tier synthesize capability. It depends DOWN on beam core, beam-tenancy (the synthetic flag and scopes already live on Beam's Tenant) and beam-commerce (the materializer writes subscriptions, bills and cost events), and it is depended ON by beam-exec, so it must never require exec back. It sits below the composed tower host and the satellite tier, which consume it; the Splicewire-specific pieces (the LLM blueprint generator, the compliance extra, the SecondParty blueprints) stay in the host for the same reason. beam-tenancy may not require beam-commerce, which is why the materializer lives here rather than in tenancy.",
            "mustRequire": [
                "splicewire/laravel-beam",
                "splicewire/laravel-beam-tenancy",
                "splicewire/laravel-beam-commerce"
            ],
            "mustNotRequire": [
                "splicewire/tower",
                "splicewire/laravel-satellite",
                "splicewire/laravel-tower-*"
            ],
            "neverReaches": [
                "splicewire/laravel-beam-exec"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/codegen.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-commerce.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-filters.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-nav.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-doctor.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-mcp-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-permission-cascade.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-postgres-rls.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-versioning.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-blockdoc.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-frame.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-json-ns.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/php-json-ns.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-accounts.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-analytics.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-commerce.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-mcp.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-mdx.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-provision.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-sitemap.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-tenancy.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-workflows.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
